{
  "PreToolUse": [
    {
      "matcher": "(?i)^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/guard.sh\""
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "(?i)^(Edit|Write|MultiEdit)$",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/post-edit.sh\""
        }
      ]
    }
  ]
}
