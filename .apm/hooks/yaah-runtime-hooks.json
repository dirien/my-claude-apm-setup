{
  "PreToolUse": [
    {
      "matcher": "(?i)^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "yaah hook PreToolUse"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "(?i)^(Edit|Write|MultiEdit)$",
      "hooks": [
        {
          "type": "command",
          "command": "yaah hook PostToolUse"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "yaah hook SessionStart"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "yaah hook SessionEnd"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "yaah hook Stop"
        }
      ]
    }
  ]
}
